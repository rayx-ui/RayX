//! The app's Rust crate: its UI set, which `App.tsx` imports from `__SPECIFIER__`. Its TypeScript
//! declarations are generated into `.nsh/types/__SPECIFIER__.d.ts`.

use rayx::prelude::*;

/// The crate's UI set (`nsh.json` `"rust"`): RayX's attribute registers every RayX TS class
/// (`RayXAppBuilder`, with which `App.tsx` builds and starts the app, `ServiceProvider` and the
/// services' classes) and RayX's components with their theme document, then this body adds
/// RayX's dev tools (`DevTools` and `<DevLayer />`: in a dev build the in-app agent a tool
/// connects to and its layer, nothing in a release build) and the app's own exports:
/// `.register::<…>()` for components, `.module::<…>()` for modules and
/// `#[rayx::app_extension]`s, `.class::<…>()`, `.contract::<dyn …>()`.
#[rayx::native_module("__SPECIFIER__")]
fn native(registry: &mut Registry) {
    registry.class::<DevTools>().register::<DevLayer>();
}
