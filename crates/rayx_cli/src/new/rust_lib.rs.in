//! The app's Rust UI: its root component, which `nsh run`, `nsh package` and `cargo run` mount,
//! and its RayX services.

use nsh_base::theme;
use nsh_core::prelude::*;
use rayx::prelude::*;

/// The app's UI set (`nsh.json` `"rust"`): what a TSX entry may import from `__SPECIFIER__`,
/// RayX's TS classes and components (RayX's attribute registers them) and the root `App`.
#[rayx::native_module("__SPECIFIER__")]
fn native(registry: &mut Registry) {
    registry.register::<App>();
}

/// The application's root component: it starts the app's services and shows where they are.
#[component]
pub fn App() -> impl IntoElement {
    // The app's composition root: its configuration and the services every surface starts with
    // (RayX's are listed in its `docs/services.md`). The host requires the first four (platform
    // state, suspension, assets and fonts), and each can be replaced by the app's own
    // implementation of its contract; history needs operations. `start()` starts them in a task
    // of its own; `app_state()` follows it.
    RayXAppBuilder::new()
        .add_platform()
        .add_suspension()
        .add_assets(|_| {})
        .add_fonts(|_| {})
        .add_storage()
        .add_operations()
        .add_history()
        .start();
    view()
        .flex_1()
        .bg(move || theme().background)
        .text_color(move || theme().foreground)
        .items_center()
        .justify_center()
        .child(
            text(move || match rayx::app_nsh::app_state() {
                rayx::app_nsh::AppState::Ready => "Ready".to_owned(),
                rayx::app_nsh::AppState::Failed(message) => format!("Failed: {message}"),
                _ => "Starting".to_owned(),
            })
            .text_size(px(22.0)),
        )
        // RayX's dev tools: in a dev build the layer a tool picks and marks views with.
        .child(dev_layer())
}
