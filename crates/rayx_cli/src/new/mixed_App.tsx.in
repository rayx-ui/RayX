import { mount, signal, Text, View } from "nsh";
import { DevLayer, KeyValueStore, RayXAppBuilder } from "__SPECIFIER__";

// The app's composition root: its configuration and the services every surface starts with
// (RayX's are listed in its `docs/services.md`). `start()` resolves with the root
// `ServiceProvider` once every startup service is ready; resolving a service after it is
// synchronous.
const status = signal("Starting");
const launches = signal(0);
new RayXAppBuilder()
  .addStorage()
  .addHistory()
  .start()
  .then((services) => {
    const store = services.getRequiredService(KeyValueStore);
    const count = Number(store.get("app", "launches") ?? "0") + 1;
    store.set("app", "launches", String(count));
    launches.set(count);
    status.set("Ready");
  })
  .catch((error) => status.set(`Failed: ${error}`));

function App() {
  return (
    <View
      style={{
        flex: 1,
        paddingTop: "env(safe-area-inset-top)",
        paddingRight: "env(safe-area-inset-right)",
        paddingBottom: "env(safe-area-inset-bottom)",
        paddingLeft: "env(safe-area-inset-left)",
        alignItems: "center", justifyContent: "center", gap: 16,
      }}
    >
      <Text style={{ fontSize: 22 }}>{status()}</Text>
      <Text>{launches() > 0 ? `Launch ${launches()}` : ""}</Text>
      {/* RayX's dev tools: in a dev build the layer a tool picks and marks views with. */}
      <DevLayer style={{ position: "absolute" }} />
    </View>
  );
}

mount(App);
